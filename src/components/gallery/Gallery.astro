---
import { galleryDict } from '@/i18n/gallery.ts';
import { pathFor } from '@/i18n/ui.ts';

const { lang } = Astro.props as { lang: 'ar' | 'en' };
const t = galleryDict[lang];
const isAr = lang === 'ar';
const contactPath = pathFor(lang, 'contact');
---

<section class="relative w-full overflow-hidden pt-space-lg pb-space-xl">
  <div class="absolute -top-40 right-1/4 w-[540px] h-[540px] rounded-full bg-secondary-container/15 blur-[120px] pointer-events-none"></div>
  <div class="absolute top-20 left-10 w-[420px] h-[420px] rounded-full bg-primary/10 blur-[100px] pointer-events-none"></div>
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-space-sm mb-space-md">
      <div class="flex items-center gap-space-xs bg-surface-container px-space-sm py-space-xs rounded-full shadow-sm">
        <span class="inline-block w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
        <span class="font-code-sm text-code-sm text-primary font-semibold tracking-wider">{t.showTag}</span>
        <span class="text-outline-variant text-[10px]">/</span>
        <span class="font-label-sm text-label-sm text-on-surface-variant">{t.year}</span>
      </div>
      <div class="flex items-center gap-space-md text-on-surface-variant font-code-sm text-code-sm">
        <span class="flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px] text-primary">verified</span>
          {t.metaOpenSource}
        </span>
        <span class="hidden sm:inline text-outline-variant">|</span>
        <span class="hidden sm:flex items-center gap-1">
          <span class="material-symbols-outlined text-[16px] text-secondary">speed</span>
          {t.metaLighthouse}
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-end mb-space-xl">
      <div class="lg:col-span-8 flex flex-col gap-space-sm">
        <span class="font-label-md text-label-md text-secondary font-bold uppercase tracking-widest">{t.eyebrow}</span>
        <h1 class="font-display-lg text-display-lg text-on-surface font-extrabold tracking-tight leading-tight">{t.title}</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">{t.desc}</p>
      </div>
      <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-space-xs">
        {
          t.metrics.map((m) => (
            <div class="flex-1 bg-surface-container-low p-space-md rounded-lg shadow-sm flex items-center justify-between">
              <div>
                <div class={`font-headline-lg text-headline-lg ${m.iconColor} font-bold`} dir="ltr">{m.value}</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">{m.label}</div>
              </div>
              <span class={`material-symbols-outlined ${m.iconColor} text-[32px] p-space-xs bg-surface rounded-lg`}>{m.icon}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="sticky top-20 z-40 bg-surface/90 backdrop-blur-md py-space-sm mb-space-xl">
      <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs no-scrollbar" id="projects-filter-bar">
        {
          t.filters.map((f, i) => (
            <button
              class={`filter-btn shrink-0 flex items-center gap-1.5 px-space-md py-space-xs rounded-lg font-label-md text-label-md font-semibold transition-all ${
                i === 0
                  ? 'bg-primary-container text-on-primary shadow-sm'
                  : 'bg-surface-container-low text-on-surface-variant hover:text-on-surface hover:bg-surface-container'
              }`}
              data-filter={f.key}
              type="button"
            >
              <span class="material-symbols-outlined text-[18px]">{f.icon}</span>
              <span>{f.label}</span>
              {f.count ? <span class="bg-surface/20 text-on-primary px-1.5 py-0.5 rounded-full text-[11px] font-code-sm">{f.count}</span> : null}
            </button>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter-lg" id="projects-container">
      {
        t.projects.map((p) => (
          <article
            class={`project-card ${p.span} bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group relative overflow-hidden`}
            data-category={p.category}
          >
            <div class="absolute top-0 right-0 left-0 h-1.5 bg-gradient-to-r from-primary-container via-secondary-container to-secondary"></div>
            <div class="flex flex-col gap-space-sm">
              <div class="flex flex-wrap items-center justify-between gap-space-xs">
                <span class={`font-code-sm text-code-sm px-space-sm py-0.5 rounded-md font-semibold ${p.badge.cls}`}>{p.badge.text}</span>
                <div class="flex items-center gap-space-xs">
                  {p.stars ? (
                    <span class="flex items-center gap-1 text-on-surface-variant font-code-sm text-code-sm">
                      <span class="material-symbols-outlined text-[16px] text-amber-500" style="font-variation-settings: 'FILL' 1;">star</span>
                      {p.stars}
                    </span>
                  ) : null}
                  {p.badge2 ? <span class={`font-label-sm text-label-sm ${p.badge2.cls}`}>{p.badge2.text}</span> : null}
                </div>
              </div>

              {
                p.image ? (
                  <div class="relative rounded-lg overflow-hidden shadow-md group-hover:scale-[1.01] transition-transform duration-300 h-64 md:h-72">
                    <img alt={p.image.alt} class="w-full h-full object-cover" loading="lazy" src={p.image.src} />
                    <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent flex items-end p-space-md">
                      <div class="bg-surface-container-lowest/90 backdrop-blur-md px-space-md py-space-xs rounded-lg shadow-sm w-full flex items-center justify-between">
                        <div class="flex items-center gap-space-xs font-code-sm text-code-sm text-on-surface" dir={isAr ? 'rtl' : 'ltr'}>
                          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block shrink-0"></span>
                          <span>{p.image.overlay.left}</span>
                        </div>
                        {p.image.overlay.right ? <span class="font-label-sm text-label-sm text-secondary font-bold">{p.image.overlay.right}</span> : null}
                      </div>
                    </div>
                  </div>
                ) : null
              }

              <h2 class={`font-headline-lg text-headline-lg text-on-surface font-bold group-hover:text-primary transition-colors ${p.span === 'md:col-span-12' ? 'md:text-display-lg-mobile' : ''}`}>{p.title}</h2>
              <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{p.desc}</p>

              {
                p.segment ? (
                  <div class="my-space-xs p-space-sm bg-surface-container-low rounded-lg">
                    <div class="flex items-center justify-between mb-space-xs font-code-sm text-code-sm text-on-surface">
                      <span class="font-semibold text-primary">{p.segment.label}</span>
                      <span dir="ltr">{p.segment.latency}</span>
                    </div>
                    <div class="w-full bg-surface-container-high h-2 rounded-full overflow-hidden flex">
                      {
                        p.segment.bars.map((bar) => (
                          <div class={`${bar.bg} h-full ${bar.w}`} title={bar.title}></div>
                        ))
                      }
                    </div>
                    <div class="flex justify-between font-label-sm text-label-sm text-on-surface-variant mt-1">
                      {p.segment.foots.map((f) => <span>{f}</span>)}
                    </div>
                  </div>
                ) : null
              }

              {
                p.terminal ? (
                  <div class="rounded-lg bg-inverse-surface p-space-sm text-on-primary font-code-sm text-code-sm overflow-x-auto select-all" dir="ltr">
                    {
                      p.terminal.lines.map((l) => (
                        <div class={l.cls}>{l.text}</div>
                      ))
                    }
                  </div>
                ) : null
              }

              {
                p.packageInfo ? (
                  <div class="p-space-md bg-surface-container-low rounded-lg flex items-center justify-between gap-space-sm mb-space-xs">
                    <div class="flex items-center gap-space-xs min-w-0">
                      <span class="material-symbols-outlined text-primary text-[28px] shrink-0">{p.packageInfo.icon}</span>
                      <div class="min-w-0">
                        <div class="font-headline-sm text-headline-sm text-on-surface font-bold">{p.packageInfo.name}</div>
                        <div class="font-code-sm text-code-sm text-on-surface-variant truncate" dir="ltr">{p.packageInfo.cmd}</div>
                      </div>
                    </div>
                    <button class="p-space-xs bg-surface text-primary rounded-md shadow-sm hover:bg-surface-container-high transition-colors shrink-0" data-copy={p.packageInfo.cmd} data-copied-label={t.copied} type="button">
                      <span class="material-symbols-outlined text-[20px]">content_copy</span>
                    </button>
                  </div>
                ) : null
              }

              <div class="flex flex-wrap items-center gap-space-xs">
                {
                  p.tags.map((tag) => (
                    <span class="bg-surface-container-high text-on-surface px-space-sm py-0.5 rounded font-code-sm text-code-sm">{tag}</span>
                  ))
                }
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-space-sm pt-space-md mt-space-sm">
              <div class="flex flex-wrap items-center gap-space-xs">
                {
                  p.cta.map((cta) => (
                    <a class={`px-space-md py-space-xs font-label-md text-label-md font-semibold rounded-lg transition-all inline-flex items-center gap-1.5 ${
                      cta.icon === 'code' || cta.icon === 'visibility' || cta.icon === 'schema' || cta.icon === 'arrow_outward'
                        ? 'bg-surface-container text-primary hover:bg-surface-container-high'
                        : 'bg-primary-container text-on-primary shadow-sm hover:brightness-110'
                    }`} href={cta.href} rel={cta.href.startsWith('http') ? 'noopener noreferrer' : undefined} target={cta.href.startsWith('http') ? '_blank' : undefined} >
                      {cta.icon === 'arrow_outward' ? null : <span class="material-symbols-outlined text-[16px]">{cta.icon}</span>}
                      <span>{cta.label}</span>
                      {cta.icon === 'arrow_outward' ? <span class="material-symbols-outlined text-[16px]">{cta.icon}</span> : null}
                    </a>
                  ))
                }
              </div>
              {p.metaRight ? <span class={`font-code-sm text-code-sm ${p.metaRightCls}`}>{p.metaRight}</span> : null}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full bg-surface-container-low py-space-xl my-space-md">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
      <div class="lg:col-span-5 flex flex-col gap-space-sm">
        <div class="flex items-center gap-space-xs text-primary font-code-sm text-code-sm font-semibold">
          <span class="material-symbols-outlined text-[18px]">account_tree</span>
          <span>{t.architecture.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface font-extrabold">{t.architecture.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{t.architecture.desc}</p>
        <div class="flex flex-col gap-space-xs mt-space-xs">
          {
            t.architecture.items.map((item) => (
              <div class="flex items-start gap-space-xs bg-surface p-space-sm rounded-lg">
                <span class={`material-symbols-outlined ${item.iconColor} text-[20px] mt-0.5`} style="font-variation-settings: 'FILL' 1;">{item.icon}</span>
                <div>
                  <h4 class="font-headline-sm text-headline-sm text-on-surface font-semibold">{item.title}</h4>
                  <p class="font-body-sm text-body-sm text-on-surface-variant">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="bg-inverse-surface rounded-xl p-space-lg text-on-primary shadow-xl relative overflow-hidden">
          <div class="flex items-center justify-between pb-space-md text-on-primary-container font-code-sm text-code-sm">
            <div class="flex items-center gap-space-xs">
              <span class="w-3 h-3 rounded-full bg-red-400"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
              <span class="w-3 h-3 rounded-full bg-green-400"></span>
              <span class="ms-2 text-on-surface-variant font-medium">{t.architecture.flowLabel}</span>
            </div>
            <span>{t.architecture.status}</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-space-sm text-center font-code-sm text-code-sm py-space-sm">
            {
              t.architecture.tiers.map((tier, i) => (
                <div class={`rounded-lg p-space-md flex flex-col items-center gap-space-xs ${i === 1 ? 'bg-surface-container-highest/20' : 'bg-surface-container-highest/10'} ${i > 0 ? 'relative' : ''}`}>
                  {i > 0 ? (
                    <span class={`hidden sm:flex absolute ${isAr ? 'left-[-10px]' : 'right-[-10px]'} top-1/2 -translate-y-1/2 text-secondary-container`}>
                      <span class={`material-symbols-outlined text-[20px] ${isAr ? 'arrow_forward' : 'arrow_back'}`} style="font-variation-settings:'FILL' 0; transform: scaleX(-1);"></span>
                    </span>
                  ) : null}
                  <span class={`material-symbols-outlined text-[32px] ${i === 0 ? 'text-secondary-fixed' : i === 1 ? 'text-secondary-container' : 'text-emerald-400'}`}>{tier.icon}</span>
                  <span class={`font-bold ${i === 0 ? 'text-secondary-fixed' : i === 1 ? 'text-secondary-container' : 'text-emerald-400'}`}>{tier.title}</span>
                  <span class="text-inverse-on-surface text-[11px]">{tier.sub}</span>
                  <span class={`px-2 py-0.5 rounded text-[10px] mt-1 ${tier.tagCls}`}>{tier.tag}</span>
                </div>
              ))
            }
          </div>
          <div class="mt-space-md pt-space-sm font-code-sm text-code-sm text-on-surface-variant flex flex-wrap items-center justify-between gap-2" dir="ltr">
            {
              t.architecture.footer.map((f) => (
                <span>{f.label} <strong class={f.cls}>{f.value}</strong></span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="w-full max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl">
  <div class="bg-surface-container-lowest rounded-xl p-space-lg md:p-space-xl shadow-sm relative overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
      <div class="lg:col-span-8 flex flex-col gap-space-sm">
        <div class="flex items-center gap-space-xs">
          <span class="p-space-xs rounded-lg bg-surface-container text-primary">
            <span class="material-symbols-outlined text-[24px]">terminal</span>
          </span>
          <span class="font-headline-sm text-headline-sm text-on-surface font-bold">{t.github.title}</span>
        </div>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">{t.github.desc}</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-sm pt-space-xs">
          {
            t.github.metrics.map((m) => (
              <div class="bg-surface-container-low p-space-sm rounded-lg">
                <div class={`font-headline-md text-headline-md ${m.cls} font-bold`}>{m.value}</div>
                <div class="font-label-sm text-label-sm text-on-surface-variant">{m.label}</div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="lg:col-span-4 flex flex-col items-stretch sm:items-start lg:items-end justify-center gap-space-sm">
        <a class="w-full sm:w-auto px-space-lg py-space-md bg-inverse-surface text-inverse-on-surface font-label-md text-label-md font-semibold rounded-xl shadow-md hover:bg-on-surface transition-all flex items-center justify-center gap-2" href="https://github.com" rel="noopener noreferrer" target="_blank">
          <span class="material-symbols-outlined text-[20px]">code</span>
          <span>{t.github.follow}</span>
        </a>
        <a class="w-full sm:w-auto px-space-lg py-space-sm bg-surface-container text-primary font-label-md text-label-md font-semibold rounded-xl hover:bg-surface-container-high transition-all flex items-center justify-center gap-2" href={contactPath}>
          <span class="material-symbols-outlined text-[20px]">handshake</span>
          <span>{t.github.sponsor}</span>
        </a>
        <span class="font-code-sm text-code-sm text-on-surface-variant">{t.github.handle}</span>
      </div>
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('#projects-filter-bar .filter-btn');
  const projectCards = document.querySelectorAll('#projects-container .project-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');

      filterButtons.forEach((btn) => {
        btn.classList.remove('bg-primary-container', 'text-on-primary');
        btn.classList.add('bg-surface-container-low', 'text-on-surface-variant');
      });
      button.classList.remove('bg-surface-container-low', 'text-on-surface-variant');
      button.classList.add('bg-primary-container', 'text-on-primary');

      projectCards.forEach((card) => {
        const categories = (card.getAttribute('data-category') as string) || '';
        if (filter === 'all' || categories.includes(filter)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const cmd = btn.getAttribute('data-copy') || '';
    const copiedLabel = btn.getAttribute('data-copied-label') || '';
    const iconEl = btn.querySelector('.material-symbols-outlined');
    const originalIcon = iconEl?.textContent || 'content_copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(cmd);
        if (iconEl) {
          iconEl.textContent = 'check_circle';
          btn.title = copiedLabel;
        }
        setTimeout(() => {
          if (iconEl) iconEl.textContent = originalIcon;
          btn.title = '';
        }, 2000);
      } catch {
        if (iconEl) {
          iconEl.textContent = 'error';
          btn.title = 'error';
          setTimeout(() => {
            if (iconEl) iconEl.textContent = originalIcon;
            btn.title = '';
          }, 2000);
        }
      }
    });
  });
</script>