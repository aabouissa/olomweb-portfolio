---
import { contactDict } from '@/i18n/contact.ts';

const { lang } = Astro.props as { lang: 'ar' | 'en' };
const t = contactDict[lang];
const isAr = lang === 'ar';
---

<section class="relative w-full overflow-hidden bg-surface-container-low py-space-xl">
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary/5 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-secondary/10 blur-3xl pointer-events-none"></div>
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
      <div class="max-w-3xl flex flex-col gap-space-sm">
        <div class="inline-flex items-center gap-space-xs px-space-sm py-space-xs rounded-full bg-surface text-primary shadow-sm w-fit">
          <span class="w-2 h-2 rounded-full bg-secondary-container animate-pulse"></span>
          <span class="font-code-sm text-code-sm tracking-wide uppercase">{t.heroBadge}</span>
        </div>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface font-bold tracking-tight">
          {t.heroTitle} <span class="text-primary underline decoration-secondary-container decoration-4 underline-offset-8">{t.heroTitleHighlight}</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">{t.heroDesc}</p>
      </div>
      <div class="bg-surface p-space-md rounded-xl shadow-md flex items-center gap-space-md shrink-0 lg:mb-2">
        <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
          <span class="material-symbols-outlined text-[28px]">schedule</span>
        </div>
        <div class="flex flex-col">
          <span class="font-label-sm text-label-sm text-on-surface-variant">{t.status.label}</span>
          <span class="font-headline-sm text-headline-sm text-on-surface font-bold">{t.status.value}</span>
          <span class="font-code-sm text-code-sm text-secondary">{t.status.note}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl w-full">
  <div class="flex flex-col gap-space-xs mb-space-lg">
    <span class="font-label-sm text-label-sm text-secondary font-semibold uppercase tracking-wider">{t.channels.eyebrow}</span>
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold">{t.channels.title}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
    {
      t.channels.items.map((ch) => (
        <a class="group bg-surface-container-lowest p-space-lg rounded-xl shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between" href={ch.href} rel={ch.target ? 'noopener noreferrer' : undefined} target={ch.target}>
          <div class="flex flex-col gap-space-sm">
            <div class={`w-12 h-12 rounded-lg ${ch.iconBg} ${ch.iconColor} flex items-center justify-center group-hover:scale-110 transition-transform`}>
              <span class="material-symbols-outlined text-[26px]">{ch.icon}</span>
            </div>
            <h3 class="font-headline-sm text-headline-sm text-on-surface group-hover:text-primary transition-colors">{ch.title}</h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{ch.desc}</p>
          </div>
          <div class="mt-space-md pt-space-sm flex items-center justify-between text-primary font-label-md text-label-md">
            <span className={ch.icon === 'alternate_email' ? 'font-code-sm text-code-sm' : ''}>{ch.cta}</span>
            <span class="material-symbols-outlined text-[18px] group-hover:-translate-x-1 transition-transform">{ch.ctaIcon}</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<section class="bg-surface-container-low py-space-xl w-full" id="consultation-tiers">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-xl">
      <span class="font-label-sm text-label-sm text-primary font-bold uppercase tracking-wider">{t.tiers.eyebrow}</span>
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold mt-space-xs">{t.tiers.title}</h2>
      <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">{t.tiers.desc}</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter-lg items-stretch">
      {
        t.tiers.items.map((tier) => (
          <div class={`rounded-xl p-space-lg flex flex-col justify-between relative overflow-hidden ${tier.highlighted ? 'bg-primary text-on-primary shadow-xl -mt-2 lg:-mt-4 mb-2 lg:mb-0' : 'bg-surface-container-lowest shadow-md'}`}>
            <div class={`absolute top-0 left-0 right-0 h-1.5 ${tier.highlighted ? 'bg-secondary-container' : 'bg-secondary-fixed'}`}></div>
            <div class="flex flex-col">
              <div class="flex items-center justify-between mb-space-md">
                <span class={`px-space-sm py-space-xs rounded-full font-code-sm text-code-sm ${tier.badgeCls}`}>{tier.badge}</span>
                <span class={`material-symbols-outlined text-[28px] ${tier.highlighted ? 'text-secondary-container' : 'text-primary'}`}>{tier.icon}</span>
              </div>
              <h3 class={`font-headline-md text-headline-md font-bold ${tier.highlighted ? 'text-on-primary' : 'text-on-surface'}`}>{tier.title}</h3>
              <span class={`font-label-md text-label-md mt-space-xs font-semibold ${tier.highlighted ? 'text-on-primary-container' : 'text-secondary'}`}>{tier.sub}</span>
              <p class={`font-body-sm text-body-sm mt-space-sm ${tier.highlighted ? 'text-on-primary/90' : 'text-on-surface-variant'}`}>{tier.desc}</p>
              <ul class={`mt-space-md flex flex-col gap-space-xs font-body-sm text-body-sm ${tier.highlighted ? 'text-on-primary/90' : 'text-on-surface-variant'}`}>
                {
                  tier.features.map((feat) => (
                    <li class="flex items-center gap-space-xs">
                      <span class={`material-symbols-outlined text-[18px] ${tier.highlighted ? 'text-secondary-container' : 'text-primary'}`} style="font-variation-settings: 'FILL' 1;">{tier.featureIcon}</span>
                      <span>{feat}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="mt-space-lg pt-space-md">
              <button class={`w-full py-space-sm px-space-md rounded-lg font-label-md text-label-md font-bold transition-all flex items-center justify-center gap-space-xs ${tier.ctaCls}`} data-inquiry={tier.inquiry} type="button">
                <span>{tier.cta}</span>
                <span class="material-symbols-outlined text-[18px]">{tier.ctaIcon}</span>
              </button>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl w-full" id="contact-form">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-start">
    <div class="lg:col-span-5 flex flex-col gap-space-lg">
      <div class="flex flex-col gap-space-xs">
        <span class="font-label-sm text-label-sm text-secondary font-bold uppercase">{t.form.leftEyebrow}</span>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold">{t.form.leftTitle}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">{t.form.leftDesc}</p>
      </div>

      <div class="bg-surface-container-low p-space-md rounded-xl shadow-sm flex flex-col gap-space-md">
        <div class="flex items-center justify-between">
          <span class="font-headline-sm text-headline-sm text-on-surface font-semibold">{t.form.statsTitle}</span>
          <span class="material-symbols-outlined text-primary text-[20px]">analytics</span>
        </div>
        <div class="grid grid-cols-3 gap-space-sm text-center">
          {
            t.form.stats.map((s) => (
              <div class="p-space-sm bg-surface rounded-lg">
                <span class={`font-headline-md text-headline-md ${s.cls} font-bold`} dir="ltr">{s.value}</span>
                <p class="font-label-sm text-label-sm text-on-surface-variant mt-1">{s.label}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="bg-inverse-surface text-inverse-on-surface p-space-md rounded-xl shadow-lg relative overflow-hidden" dir="ltr">
        <div class="flex items-center justify-between pb-space-xs mb-space-sm border-b border-white/10">
          <div class="flex items-center gap-1.5">
            <span class="w-3 h-3 rounded-full bg-error inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-yellow-400 inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-green-500 inline-block"></span>
          </div>
          <span class="font-code-sm text-code-sm text-secondary-fixed">{t.form.file}</span>
        </div>
        <pre class="font-code-sm text-code-sm leading-relaxed overflow-x-auto text-secondary-fixed-dim"><code>{t.form.code}</code></pre>
      </div>

      <div class="relative rounded-xl overflow-hidden shadow-md">
        <img alt={t.form.imageAlt} class="w-full h-48 object-cover" loading="lazy" src="/images/contact-desk.png" />
        <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface/80 via-transparent to-transparent flex items-end p-space-md">
          <span class="font-label-md text-label-md text-inverse-on-surface font-semibold">{t.form.imageLabel}</span>
        </div>
      </div>
    </div>

    <div class="lg:col-span-7 bg-surface-container-lowest p-space-lg md:p-space-xl rounded-xl shadow-xl">
      <form class="flex flex-col gap-space-md" id="consultationInquiryForm" novalidate>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-md text-label-md text-on-surface font-semibold" for="fullName">
              {t.form.fields.fullName} <span class="text-error">{t.form.fields.fullNameRequired}</span>
            </label>
            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="fullName" placeholder={t.form.fields.fullNamePlaceholder} required type="text" />
          </div>
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-md text-label-md text-on-surface font-semibold" for="email">
              {t.form.fields.email} <span class="text-error">{t.form.fields.emailRequired}</span>
            </label>
            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary transition-all" dir="ltr" id="email" placeholder={t.form.fields.emailPlaceholder} required type="email" />
          </div>
        </div>

        <div class="flex flex-col gap-space-xs">
          <label class="font-label-md text-label-md text-on-surface font-semibold" for="inquiryType">
            {t.form.fields.inquiryLabel} <span class="text-error">{t.form.fields.inquiryRequired}</span>
          </label>
          <div class="relative">
            <select class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary focus:ring-primary appearance-none transition-all cursor-pointer" id="inquiryType" required>
              {
                t.form.fields.inquiryOptions.map((o) => <option value={o.value}>{o.label}</option>)
              }
            </select>
            <span class="material-symbols-outlined absolute left-3 top-2.5 pointer-events-none text-on-surface-variant">expand_more</span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md">
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-md text-label-md text-on-surface font-semibold" for="platformPreference">{t.form.fields.platformLabel}</label>
            <div class="relative">
              <select class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary appearance-none transition-all cursor-pointer" id="platformPreference">
                {
                  t.form.fields.platformOptions.map((o) => <option value={o.value}>{o.label}</option>)
                }
              </select>
              <span class="material-symbols-outlined absolute left-3 top-2.5 pointer-events-none text-on-surface-variant">expand_more</span>
            </div>
          </div>
          <div class="flex flex-col gap-space-xs">
            <label class="font-label-md text-label-md text-on-surface font-semibold" for="targetDate">{t.form.fields.dateLabel}</label>
            <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary transition-all" id="targetDate" placeholder={t.form.fields.datePlaceholder} type="text" />
          </div>
        </div>

        <div class="flex flex-col gap-space-xs">
          <label class="font-label-md text-label-md text-on-surface font-semibold" for="messageBody">
            {t.form.fields.messageLabel} <span class="text-error">{t.form.fields.messageRequired}</span>
          </label>
          <textarea class="w-full p-space-md rounded-lg bg-surface-container-low text-on-surface placeholder:text-outline font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-primary transition-all resize-y" id="messageBody" placeholder={t.form.fields.messagePlaceholder} required rows="5"></textarea>
        </div>

        <div class="flex items-start gap-space-xs">
          <span class="material-symbols-outlined text-primary text-[20px] mt-0.5">lock</span>
          <p class="font-body-sm text-body-sm text-on-surface-variant">{t.form.fields.privacy}</p>
        </div>

        <div class="pt-space-xs">
          <button class="w-full py-space-sm px-space-lg rounded-lg bg-primary hover:bg-primary-container text-on-primary font-headline-sm text-headline-sm font-bold shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-space-sm" data-sending={t.form.fields.sending} id="submitButton" type="submit">
            <span id="submit-label">{t.form.fields.submit}</span>
            <span class="material-symbols-outlined text-[22px]">send</span>
          </button>
        </div>

        <div class="hidden p-space-md rounded-lg bg-secondary-container text-on-secondary-container items-center gap-space-sm shadow-md" id="formSuccessToast">
          <span class="material-symbols-outlined text-[24px]">check_circle</span>
          <div class="flex flex-col">
            <span class="font-headline-sm text-headline-sm font-bold">{t.form.fields.success}</span>
            <span class="font-body-sm text-body-sm">{t.form.fields.successSub}</span>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>

<section class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl w-full">
  <div class="flex flex-col items-center text-center max-w-2xl mx-auto mb-space-xl">
    <span class="font-label-sm text-label-sm text-primary font-bold uppercase tracking-wider">{t.faq.eyebrow}</span>
    <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface font-bold mt-space-xs">{t.faq.title}</h2>
    <p class="font-body-md text-body-md text-on-surface-variant mt-space-xs">{t.faq.desc}</p>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
    {
      t.faq.items.map((f) => (
        <div class="bg-surface-container-low p-space-lg rounded-xl shadow-sm flex flex-col gap-space-xs">
          <div class="flex items-center gap-space-xs text-primary font-headline-sm text-headline-sm font-bold">
            <span class="material-symbols-outlined text-[24px]">{f.icon}</span>
            <h3>{f.question}</h3>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{f.answer}</p>
        </div>
      ))
    }
  </div>
</section>

<script>
  const inquirySelect = document.getElementById('inquiryType') as HTMLSelectElement | null;

  document.querySelectorAll<HTMLElement>('[data-inquiry]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (inquirySelect) {
        inquirySelect.value = btn.getAttribute('data-inquiry') || '';
      }
      document.getElementById('contact-form')?.scrollIntoView({ behavior: 'smooth' });
    });
  });

  const form = document.getElementById('consultationInquiryForm') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submitButton') as HTMLButtonElement | null;
  const submitLabel = document.getElementById('submit-label') as HTMLElement | null;
  const toast = document.getElementById('formSuccessToast') as HTMLElement | null;

  if (form && submitBtn && submitLabel && toast) {
    const sendingText = submitBtn.getAttribute('data-sending') || '';
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      submitBtn.disabled = true;
      submitBtn.innerHTML =
        '<span class="material-symbols-outlined animate-spin text-[22px]">sync</span> <span id="submit-label">' +
        sendingText +
        '</span>';

      setTimeout(() => {
        submitBtn.classList.add('hidden');
        toast.classList.remove('hidden');
        toast.classList.add('flex');
        form.reset();
      }, 1000);
    });
  }
</script>