---
import { homeDict } from '@/i18n/home.ts';
import { ui, localizedRoutes } from '@/i18n/ui.ts';

const { lang } = Astro.props as { lang: 'ar' | 'en' };
const t = homeDict[lang];
const U = ui[lang];
const routes = localizedRoutes(lang);
const isAr = lang === 'ar';
const backArrow = isAr ? 'arrow_back' : 'arrow_forward';

const spanTwo = ['0', '3'];
const accentIndex = '4';
---

<section class="relative w-full overflow-hidden bg-surface-container-low py-space-xl md:py-24">
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-secondary-container/20 blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -left-20 w-80 h-80 rounded-full bg-primary-container/15 blur-3xl pointer-events-none"></div>
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
      <div class="lg:col-span-7 flex flex-col gap-space-md">
        <h1 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-on-surface leading-tight">
          <span class="text-primary font-bold inline-block">{t.heroTitleB}</span>
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">{t.heroDesc}</p>

        <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
          <a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-primary-container text-on-primary font-label-md text-label-md shadow-md hover:brightness-110 transition-all" href={routes.courses}>
            <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">play_circle</span>
            <span>{t.ctaWatch}</span>
          </a>
          <a class="inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-lg bg-surface-container-lowest text-primary font-label-md text-label-md shadow-sm hover:bg-surface-container transition-all" href={routes.projects}>
            <span class="material-symbols-outlined text-[20px]">layers</span>
            <span>{t.ctaProjects}</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="w-full bg-surface-container-lowest rounded-xl shadow-xl overflow-hidden">
          <div class="h-64 w-full relative overflow-hidden bg-surface-container-high">
            <img class="w-full h-full object-cover" alt={t.heroImageAlt} src="/images/studio-hero.png" />
            <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface via-transparent to-transparent opacity-80"></div>
            <div class="absolute bottom-4 right-4 text-inverse-on-surface">
              <span class="font-code-sm text-code-sm px-2 py-0.5 rounded bg-surface-container-highest/30 backdrop-blur-md text-on-primary font-semibold">{t.founderBadge}</span>
              <h3 class="font-headline-sm text-headline-sm text-on-primary mt-1">{t.founderTagline}</h3>
            </div>
          </div>
          <div class="bg-inverse-surface p-space-md text-inverse-on-surface" dir="ltr">
            <div class="flex items-center justify-between pb-space-xs mb-space-xs opacity-60">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-error"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-secondary-container"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-primary-fixed-dim"></span>
              </div>
              <span class="font-code-sm text-code-sm text-secondary-fixed">{t.terminalManifesto}</span>
            </div>
            <div class="font-code-sm text-code-sm leading-relaxed space-y-1 text-surface-container-highest" dir="ltr">
              <p><span class="text-secondary-fixed-dim">const</span> <span class="text-primary-fixed">mission</span> = {'{'}</p>
              <p class="pl-4">platform: <span class="text-secondary-fixed">"{t.terminalMission}"</span>,</p>
              <p class="pl-4">target: <span class="text-secondary-fixed">"{t.terminalTarget}"</span>,</p>
              <p class="pl-4">principles: [<span class="text-secondary-fixed">{t.terminalPrinciples.split(', ').map(p => `"${p}"`).join(', ')}</span>],</p>
              <p class="pl-4">status: <span class="text-secondary-fixed">"{t.terminalStatus}"</span></p>
              <p>{'};'}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="w-full bg-surface-container-lowest shadow-sm py-space-lg">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-gutter">
      {
        t.stats.map((stat) => (
          <div class="flex flex-col items-center md:items-start gap-1 p-space-sm rounded-lg hover:bg-surface-container-low transition-colors">
            <div class="flex items-center gap-space-xs text-primary">
              <span class="material-symbols-outlined text-[24px]">{stat.icon}</span>
              <span class="font-headline-lg text-headline-lg font-bold text-on-surface">{stat.value}</span>
            </div>
            <span class="font-label-md text-label-md text-on-surface-variant font-medium">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl md:py-24 bg-surface" id="youtube-courses">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop flex flex-col gap-space-xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-xs text-primary">
          <span class="material-symbols-outlined text-[22px]">ondemand_video</span>
          <span class="font-code-sm text-code-sm font-bold tracking-wide uppercase">{t.playlists.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">{t.playlists.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">{t.playlists.desc}</p>
      </div>
      <a class="inline-flex items-center gap-space-xs font-label-md text-label-md text-primary font-bold hover:text-secondary transition-colors self-start md:self-auto" href={routes.courses}>
        <span>{t.playlists.browseAll}</span>
        <span class="material-symbols-outlined text-[18px]">{backArrow}</span>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter">
      {
        t.playlists.cards.map((card) => (
          <div class="flex flex-col bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div class="relative h-44 w-full overflow-hidden bg-surface-container-high">
              <img class="w-full h-full object-cover" alt={card.alt} src={card.img} />
              <div class="absolute inset-0 bg-gradient-to-t from-on-surface/80 via-transparent to-transparent"></div>
              <span class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-surface-container-lowest/90 backdrop-blur-sm font-code-sm text-code-sm text-primary font-bold">{card.badge}</span>
              <span class="absolute bottom-2 left-2 px-2 py-0.5 rounded bg-inverse-surface/80 text-inverse-on-surface font-code-sm text-code-sm">{card.duration}</span>
            </div>
            <div class="p-space-md flex flex-col flex-1 justify-between gap-space-sm">
              <div class="flex flex-col gap-space-xs">
                <span class="font-label-sm text-label-sm text-secondary font-bold">{card.tag}</span>
                <h3 class="font-headline-sm text-headline-sm text-on-surface hover:text-primary transition-colors">{card.title}</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-2">{card.desc}</p>
              </div>
              <div class="pt-space-xs flex items-center justify-between gap-space-xs">
                <a class="inline-flex items-center gap-1 text-primary font-label-sm text-label-sm hover:underline" href="https://youtube.com" target="_blank" rel="noopener noreferrer">
                  <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                  <span>{t.playlists.watchCourse}</span>
                </a>
                <a class="inline-flex items-center gap-1 text-on-surface-variant hover:text-on-surface font-code-sm text-code-sm" href="https://github.com" target="_blank" rel="noopener noreferrer">
                  <span class="material-symbols-outlined text-[16px]">terminal</span>
                  <span>{t.playlists.github}</span>
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl md:py-24 bg-surface-container-low" id="flagship-projects">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop flex flex-col gap-space-xl">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
      <div class="flex flex-col gap-space-xs">
        <div class="flex items-center gap-space-xs text-primary">
          <span class="material-symbols-outlined text-[22px]">developer_mode</span>
          <span class="font-code-sm text-code-sm font-bold tracking-wide uppercase">{t.projects.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">{t.projects.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant max-w-xl">{t.projects.desc}</p>
      </div>
      <a class="inline-flex items-center gap-space-xs font-label-md text-label-md text-primary font-bold hover:text-secondary transition-colors self-start md:self-auto" href={routes.projects}>
        <span>{t.projects.viewAll}</span>
        <span class="material-symbols-outlined text-[18px]">{backArrow}</span>
      </a>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
      {
        t.projects.flagships.map((p) => (
          <div class="flex flex-col bg-surface-container-lowest rounded-xl p-space-lg shadow-sm hover:shadow-xl transition-all duration-300 justify-between">
            <div class="flex flex-col gap-space-md">
              <div class="flex items-center justify-between">
                <div class="w-12 h-12 rounded-lg bg-surface-container flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined text-[28px]">{p.icon}</span>
                </div>
                <span class="font-code-sm text-code-sm px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed font-semibold">{p.version}</span>
              </div>
              <div class="flex flex-col gap-space-xs">
                <h3 class="font-headline-md text-headline-md text-on-surface">{p.title}</h3>
                <p class="font-body-md text-body-md text-on-surface-variant">{p.desc}</p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-space-xs">
                {
                  p.tags.map((tag) => (
                    <span class="px-2.5 py-1 rounded bg-surface-container font-code-sm text-code-sm text-primary font-medium">{tag}</span>
                  ))
                }
              </div>
            </div>
            <div class="flex items-center justify-between pt-space-lg mt-space-md">
              <a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary font-bold hover:underline" href="#">
                <span>{p.cta}</span>
                <span class="material-symbols-outlined text-[16px]">open_in_new</span>
              </a>
              <a aria-label={U.social.github} class="p-2 rounded-lg bg-surface-container text-on-surface-variant hover:text-on-surface transition-colors" href="https://github.com" target="_blank" rel="noopener noreferrer">
                <span class="material-symbols-outlined text-[20px]">code</span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl md:py-24 bg-surface">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop flex flex-col gap-space-xl">
    <div class="flex flex-col gap-space-xs text-center items-center">
      <div class="flex items-center gap-space-xs text-primary">
        <span class="material-symbols-outlined text-[20px]">tune</span>
        <span class="font-code-sm text-code-sm font-bold tracking-wide uppercase">{t.stack.eyebrow}</span>
      </div>
      <h2 class="font-headline-lg text-headline-lg text-on-surface">{t.stack.title}</h2>
      <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl">{t.stack.desc}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-gutter">
      {
        t.stack.items.map((item, i) => {
          const idx = String(i);
          const spansTwo = spanTwo.includes(idx);
          const accent = idx === accentIndex;
          return (
            <div
              class={`${spansTwo ? 'md:col-span-2' : ''} ${accent ? 'bg-primary text-on-primary p-space-lg rounded-xl shadow-md' : 'bg-surface-container-lowest p-space-lg rounded-xl shadow-sm'} flex flex-col justify-between gap-space-md`}
            >
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-space-xs">
                  <span class={`material-symbols-outlined ${accent ? 'text-secondary-fixed' : 'text-primary'} text-[28px]`}>{item.icon}</span>
                  <h3 class={`font-headline-sm text-headline-sm ${accent ? 'text-on-primary' : 'text-on-surface'}`}>{item.title}</h3>
                </div>
                {item.target && (
                  <span class={`font-code-sm text-code-sm ${accent ? 'text-on-primary-container' : 'text-secondary'} font-bold`}>{item.target}</span>
                )}
              </div>
              <p class={`font-body-md text-body-md ${accent ? 'text-on-primary/90' : 'text-on-surface-variant'}`}>{item.desc}</p>
              <div class={item.chips ? (item.chips.length > 4 ? 'grid grid-cols-2 sm:grid-cols-4 gap-space-xs' : 'flex flex-wrap gap-1.5') : ''}>
                {
                  item.chips ? (
                    item.chips.length > 4
                      ? item.chips.map((chip) => (
                          <div class={`p-space-xs rounded-lg text-center font-code-sm text-code-sm font-semibold ${accent ? 'bg-primary-container text-on-primary-container' : 'bg-surface-container-low text-on-surface'}`}>{chip}</div>
                        ))
                      : item.chips.map((chip) => (
                          <span class={`px-2 py-1 rounded font-code-sm text-code-sm ${accent ? 'bg-primary-container text-on-primary-container' : 'bg-surface-container text-primary'}`}>{chip}</span>
                        ))
                  ) : null
                }
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl md:py-24 bg-surface-container-low">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
      <div class="lg:col-span-5 flex flex-col gap-space-md">
        <div class="relative w-full h-80 rounded-xl overflow-hidden shadow-lg bg-surface-container-high">
          <img class="w-full h-full object-cover" alt={t.philosophy.imageAlt} src="/images/about-hands.png" />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/80 to-transparent"></div>
          <div class="absolute bottom-6 right-6 left-6 text-on-primary">
            <span class="font-code-sm text-code-sm text-secondary-fixed font-semibold">{t.philosophy.missionLabel}</span>
            <p class="font-headline-sm text-headline-sm font-bold mt-1">{t.philosophy.missionQuote}</p>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 flex flex-col gap-space-md">
        <div class="flex items-center gap-space-xs text-primary">
          <span class="material-symbols-outlined text-[20px]">auto_stories</span>
          <span class="font-code-sm text-code-sm font-bold tracking-wide uppercase">{t.philosophy.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">{t.philosophy.title}</h2>
        <div class="font-body-lg text-body-lg text-on-surface-variant flex flex-col gap-space-sm leading-relaxed">
          <p>{t.philosophy.p1}</p>
          <p>{t.philosophy.p2}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-space-md pt-space-xs">
          <div class="flex items-start gap-space-xs">
            <span class="material-symbols-outlined text-primary text-[24px] shrink-0">check_circle</span>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-on-surface">{t.philosophy.f1Title}</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">{t.philosophy.f1Desc}</span>
            </div>
          </div>
          <div class="flex items-start gap-space-xs">
            <span class="material-symbols-outlined text-primary text-[24px] shrink-0">check_circle</span>
            <div class="flex flex-col">
              <span class="font-headline-sm text-headline-sm text-on-surface">{t.philosophy.f2Title}</span>
              <span class="font-body-sm text-body-sm text-on-surface-variant">{t.philosophy.f2Desc}</span>
            </div>
          </div>
        </div>
        <div class="pt-space-xs">
          <a class="inline-flex items-center gap-space-xs font-label-md text-label-md text-primary font-bold hover:text-secondary transition-colors" href={routes.about}>
            <span>{t.philosophy.readMore}</span>
            <span class="material-symbols-outlined text-[18px]">{backArrow}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="w-full py-space-xl md:py-24 bg-surface">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="relative w-full rounded-2xl bg-inverse-surface text-inverse-on-surface p-space-lg md:p-16 overflow-hidden shadow-2xl">
      <div class="absolute -top-32 -left-32 w-80 h-80 rounded-full bg-primary-container/20 blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -right-32 w-80 h-80 rounded-full bg-secondary-container/20 blur-3xl pointer-events-none"></div>
      <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-gutter-lg items-center">
        <div class="lg:col-span-7 flex flex-col gap-space-sm">
          <div class="inline-flex items-center gap-space-xs self-start px-space-sm py-1 rounded-full bg-surface-container-highest/20 text-secondary-fixed">
            <span class="material-symbols-outlined text-[16px]">mail</span>
            <span class="font-code-sm text-code-sm font-bold">{t.newsletter.badge}</span>
          </div>
          <h2 class="font-headline-lg text-headline-lg md:font-display-lg md:text-display-lg text-on-primary">{t.newsletter.title}</h2>
          <p class="font-body-lg text-body-lg text-surface-container-highest max-w-xl">{t.newsletter.desc}</p>
          <form
            id="newsletter-form"
            class="flex flex-col sm:flex-row gap-space-xs max-w-lg pt-space-xs"
          >
            <input
              class="flex-1 px-space-md py-space-sm rounded-lg bg-surface-container-lowest text-on-surface placeholder:text-on-surface-variant text-body-md focus:outline-none focus:ring-2 focus:ring-secondary-container"
              placeholder={t.newsletter.placeholder}
              required
              type="email"
            />
            <button class="px-space-lg py-space-sm rounded-lg bg-secondary-container text-on-secondary-container font-label-md text-label-md font-bold hover:brightness-110 transition-all shrink-0" type="submit">
              {t.newsletter.subscribe}
            </button>
          </form>
          <p class="hidden text-secondary-fixed font-body-sm text-body-sm" id="nl-success">{t.newsletter.success}</p>
        </div>
        <div class="lg:col-span-5 flex flex-col gap-space-sm bg-surface-container-highest/10 p-space-md rounded-xl backdrop-blur-sm">
          <span class="font-label-md text-label-md text-secondary-fixed font-bold">{t.newsletter.channelsTitle}</span>
          {
            t.newsletter.channels.map((ch, i) => (
              <a
                class="flex items-center justify-between p-space-sm rounded-lg bg-surface-container-lowest/10 hover:bg-surface-container-lowest/20 transition-all text-on-primary"
                href={i === 0 ? 'https://youtube.com' : i === 2 ? 'https://github.com' : '#'}
                target={i === 0 || i === 2 ? '_blank' : undefined}
                rel={i === 0 || i === 2 ? 'noopener noreferrer' : undefined}
              >
                <div class="flex items-center gap-space-sm">
                  <span class="material-symbols-outlined text-[24px] text-secondary-fixed">{ch.icon}</span>
                  <div class="flex flex-col">
                    <span class="font-headline-sm text-headline-sm">{ch.title}</span>
                    <span class="font-body-sm text-body-sm text-surface-container-high">{ch.desc}</span>
                  </div>
                </div>
                <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const success = document.getElementById('nl-success') as HTMLElement | null;
  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      success.classList.remove('hidden');
      form.reset();
    });
  }
</script>