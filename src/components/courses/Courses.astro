---
import { coursesDict } from '@/i18n/courses.ts';
import { localizedRoutes } from '@/i18n/ui.ts';

const { lang } = Astro.props as { lang: 'ar' | 'en' };
const t = coursesDict[lang];
const routes = localizedRoutes(lang);
const isAr = lang === 'ar';
---

<section class="relative w-full overflow-hidden bg-surface-container-lowest py-space-xl">
  <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-secondary-container/15 blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/2 -right-40 w-80 h-80 rounded-full bg-primary-fixed/20 blur-3xl pointer-events-none"></div>
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg pb-space-lg">
      <div class="flex flex-col gap-space-xs max-w-3xl">
        <div class="inline-flex items-center gap-space-xs self-start px-space-sm py-1 rounded-full bg-surface-container text-primary font-code-sm text-code-sm">
          <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
          <span>{t.heroBadge}</span>
          <span class="text-outline-variant">/</span>
          <span class="font-bold">{t.heroYear}</span>
        </div>
        <h1 class="font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface tracking-tight">{t.heroTitle}</h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">{t.heroDesc}</p>
      </div>
      <div class="flex flex-wrap items-center gap-space-sm self-start lg:self-auto">
        <a class={`inline-flex items-center gap-space-xs px-space-lg py-space-sm rounded-xl bg-error text-on-error font-label-md text-label-md shadow-md hover:brightness-110 active:scale-95 transition-all ${isAr ? '' : ''}`} href="https://youtube.com" rel="noopener noreferrer" target="_blank">
          <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">smart_display</span>
          <span>{t.subscribe}</span>
        </a>
        <a class="inline-flex items-center gap-space-xs px-space-md py-space-sm rounded-xl bg-surface-container-high text-on-surface font-label-md text-label-md hover:bg-surface-container-highest transition-colors" href="#github-resources">
          <span class="material-symbols-outlined text-[20px]">folder_code</span>
          <span>{t.repos}</span>
        </a>
      </div>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-space-md pt-space-md">
      {
        t.metrics.map((m) => (
          <div class="p-space-md rounded-xl bg-surface-container-low flex items-center gap-space-md shadow-sm">
            <div class="w-12 h-12 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary shrink-0">
              <span class="material-symbols-outlined text-[26px]">{m.icon}</span>
            </div>
            <div class="flex flex-col min-w-0">
              <span class={`font-headline-md text-headline-md font-bold ${m.color}`}>{m.value}</span>
              <span class="font-label-sm text-label-sm text-on-surface-variant truncate">{m.label}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-lg bg-surface">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md pb-space-lg">
      <div>
        <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider block">{isAr ? 'مسارات التعلم المتخصصة' : 'Specialized learning tracks'}</span>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">{t.filtersTitle}</h2>
      </div>
      <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs no-scrollbar" id="category-filter-bar">
        {
          t.filters.map((f) => (
            <button
              class={`filter-btn px-space-md py-space-xs rounded-lg font-label-md text-label-md whitespace-nowrap transition-all ${
                f.key === 'all' ? 'bg-primary text-on-primary shadow-sm' : 'bg-surface-container text-on-surface-variant hover:bg-surface-container-high'
              }`}
              data-filter={f.key}
            >
              {f.label}
            </button>
          ))
        }
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter-lg" id="courses-grid">
      {
        t.courses.map((c) => (
          <article class={`course-card flex flex-col rounded-xl bg-surface-container-lowest overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1`} data-category={c.category}>
            <div class={`h-1 ${c.bar} w-full`}></div>
            <div class="relative w-full aspect-video bg-inverse-surface overflow-hidden group">
              <img class="w-full h-full object-cover opacity-90 group-hover:scale-105 transition-transform duration-500" alt={c.alt} src={c.img} loading="lazy" />
              <div class="absolute inset-0 bg-gradient-to-t from-inverse-surface via-inverse-surface/40 to-transparent"></div>
              <div class="absolute top-space-sm right-space-sm flex items-center gap-space-xs">
                <span class="px-space-xs py-0.5 rounded bg-surface-container-lowest/90 backdrop-blur-md text-primary font-label-sm text-label-sm font-semibold">{c.level}</span>
                <span class="px-space-xs py-0.5 rounded bg-inverse-surface/80 backdrop-blur-md text-on-primary font-code-sm text-code-sm">{c.track}</span>
              </div>
              <a aria-label={t.playLabel} class="absolute inset-0 flex items-center justify-center" href="https://youtube.com" target="_blank" rel="noopener noreferrer">
                <span class="w-14 h-14 rounded-full bg-primary-container text-on-primary flex items-center justify-center shadow-lg group-hover:scale-110 group-hover:bg-error transition-all">
                  <span class={`material-symbols-outlined text-[32px] ${isAr ? 'mr-0' : 'ml-0.5'}`} style="font-variation-settings: 'FILL' 1;">play_arrow</span>
                </span>
              </a>
              <div class="absolute bottom-space-sm left-space-sm right-space-sm flex items-center justify-between text-inverse-on-surface font-code-sm text-code-sm">
                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">video_library</span> {c.lessons}</span>
                <span class="flex items-center gap-1"><span class="material-symbols-outlined text-[16px]">timer</span> {c.duration}</span>
              </div>
            </div>
            <div class="p-space-lg flex flex-col flex-1 justify-between gap-space-md">
              <div class="flex flex-col gap-space-xs">
                <div class="flex flex-wrap items-center gap-space-xs mb-1">
                  {
                    c.tags.map((tag) => (
                      <span class="px-2 py-0.5 rounded-full bg-surface-container-high text-on-surface font-code-sm text-code-sm">{tag}</span>
                    ))
                  }
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface leading-snug">{c.title}</h3>
                <p class="font-body-sm text-body-sm text-on-surface-variant line-clamp-3">{c.desc}</p>
              </div>
              <div class="flex items-center justify-between pt-space-sm bg-surface-container-low p-space-sm rounded-lg">
                <a class="inline-flex items-center gap-1 font-label-md text-label-md text-primary font-semibold hover:text-secondary transition-colors" href="https://youtube.com" target="_blank" rel="noopener noreferrer">
                  <span>{t.watchYoutube}</span>
                  <span class="material-symbols-outlined text-[18px]">open_in_new</span>
                </a>
                <a class="inline-flex items-center gap-1 font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors" href="https://github.com" target="_blank" rel="noopener noreferrer">
                  <span class="material-symbols-outlined text-[18px]">code</span>
                  <span>{t.code}</span>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl bg-surface-container-low" id="github-resources">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="rounded-2xl bg-surface-container-lowest p-space-lg md:p-space-xl shadow-md flex flex-col lg:flex-row items-center justify-between gap-space-xl relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-72 h-72 bg-secondary-fixed/30 rounded-full blur-3xl pointer-events-none"></div>
      <div class="flex flex-col gap-space-sm max-w-2xl relative z-10">
        <div class="inline-flex items-center gap-space-xs text-secondary font-label-md text-label-md font-bold">
          <span class="material-symbols-outlined text-[20px]">terminal</span>
          <span>{t.gh.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface leading-snug">{t.gh.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">{t.gh.desc}</p>
        <div class="flex flex-wrap items-center gap-space-md pt-space-xs font-code-sm text-code-sm text-on-surface">
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-primary text-[18px]">check_circle</span>
            <span>{t.gh.f1}</span>
          </div>
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-primary text-[18px]">check_circle</span>
            <span>{t.gh.f2}</span>
          </div>
        </div>
      </div>
      <div class="w-full lg:w-auto shrink-0 flex flex-col sm:flex-row items-stretch sm:items-center gap-space-sm relative z-10">
        <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-md rounded-xl bg-on-surface text-surface-container-lowest font-label-md text-label-md hover:bg-primary transition-all shadow-md" href="https://github.com" rel="noopener noreferrer" target="_blank">
          <span class="material-symbols-outlined text-[20px]">code</span>
          <span>{t.gh.browse}</span>
        </a>
        <a class="inline-flex items-center justify-center gap-space-xs px-space-md py-space-md rounded-xl bg-surface-container-high text-on-surface font-label-md text-label-md hover:bg-surface-container-highest transition-colors" href="#">
          <span class="material-symbols-outlined text-[20px]">description</span>
          <span>{t.gh.pdf}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<section class="w-full py-space-xl bg-surface">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="flex flex-col items-center text-center gap-space-xs max-w-2xl mx-auto mb-space-xl">
      <span class="font-label-sm text-label-sm text-secondary font-bold uppercase tracking-wider">{t.testimonials.eyebrow}</span>
      <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">{t.testimonials.title}</h2>
      <p class="font-body-md text-body-md text-on-surface-variant">{t.testimonials.desc}</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter-lg">
      {
        t.testimonials.items.map((item) => (
          <div class="p-space-lg rounded-xl bg-surface-container-lowest shadow-sm flex flex-col justify-between gap-space-md">
            <div class="flex flex-col gap-space-sm">
              <div class="flex items-center gap-1 text-secondary">
                {
                  Array.from({ length: 5 }).map(() => (
                    <span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">star</span>
                  ))
                }
              </div>
              <p class="font-body-md text-body-md text-on-surface leading-relaxed">{item.quote}</p>
            </div>
            <div class="flex items-center gap-space-sm pt-space-xs">
              <div class={`w-10 h-10 rounded-full bg-surface-container-highest flex items-center justify-center font-bold ${item.color}`}>{item.initial}</div>
              <div class="flex flex-col">
                <span class="font-label-md text-label-md text-on-surface font-semibold">{item.name}</span>
                <span class="font-label-sm text-label-sm text-on-surface-variant">{item.role}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="w-full py-space-xl bg-surface-container-lowest">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop">
    <div class="rounded-2xl bg-surface-container p-space-lg md:p-space-xl flex flex-col lg:flex-row items-center justify-between gap-space-xl shadow-sm">
      <div class="flex flex-col gap-space-xs max-w-xl">
        <div class="inline-flex items-center gap-space-xs text-primary font-label-md text-label-md font-semibold">
          <span class="material-symbols-outlined text-[20px]">lightbulb</span>
          <span>{t.suggest.eyebrow}</span>
        </div>
        <h2 class="font-headline-lg text-headline-lg-mobile md:text-headline-lg text-on-surface">{t.suggest.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">{t.suggest.desc}</p>
      </div>
      <form class="w-full lg:w-[480px] bg-surface-container-lowest p-space-lg rounded-xl shadow-md flex flex-col gap-space-md" id="suggest-topic-form">
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-md text-label-md text-on-surface" for="topic-title">{t.suggest.topicLabel}</label>
          <input class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-secondary-container transition-all" id="topic-title" placeholder={t.suggest.topicPlaceholder} required type="text" />
        </div>
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-md text-label-md text-on-surface" for="topic-field">{t.suggest.fieldLabel}</label>
          <select class="w-full h-11 px-space-md rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-secondary-container transition-all" id="topic-field">
            {
              t.suggest.fields.map((f) => <option value={f.value}>{f.label}</option>)
            }
          </select>
        </div>
        <div class="flex flex-col gap-space-xs">
          <label class="font-label-md text-label-md text-on-surface" for="topic-details">{t.suggest.detailsLabel}</label>
          <textarea class="w-full p-space-md rounded-lg bg-surface-container-low text-on-surface font-body-sm text-body-sm focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-secondary-container transition-all" id="topic-details" placeholder={t.suggest.detailsPlaceholder} rows="3"></textarea>
        </div>
        <button class="w-full py-space-sm rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-semibold hover:brightness-105 active:scale-[0.99] transition-all flex items-center justify-center gap-space-xs shadow-sm" type="submit">
          <span class="material-symbols-outlined text-[20px]">send</span>
          <span>{t.suggest.submit}</span>
        </button>
        <div class="hidden p-space-sm rounded-lg bg-surface-container text-primary font-label-md text-label-md text-center" id="suggest-success">{t.suggest.success}</div>
      </form>
    </div>
  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.course-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterButtons.forEach((b) => {
        b.classList.remove('bg-primary', 'text-on-primary');
        b.classList.add('bg-surface-container', 'text-on-surface-variant');
      });

      btn.classList.add('bg-primary', 'text-on-primary');
      btn.classList.remove('bg-surface-container', 'text-on-surface-variant');

      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (filter === 'all' || cardCategory === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  const suggestForm = document.getElementById('suggest-topic-form') as HTMLFormElement | null;
  const suggestSuccess = document.getElementById('suggest-success') as HTMLElement | null;
  if (suggestForm && suggestSuccess) {
    suggestForm.addEventListener('submit', (e) => {
      e.preventDefault();
      suggestSuccess.classList.remove('hidden');
      suggestForm.reset();
    });
  }
</script>