---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui } from '../i18n/ui.ts';
import '../styles/global.css';

const { lang = 'ar', active = 'home', title, description } = Astro.props as {
  lang?: 'ar' | 'en';
  active?: 'home' | 'courses' | 'projects' | 'about' | 'contact';
  title?: string;
  description?: string;
};

const dir = lang === 'ar' ? 'rtl' : 'ltr';
const U = ui[lang];
---

<!doctype html>
<html dir={dir} lang={lang} class="bg-surface">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description ?? U.metaDescription} />
    <title>{title ?? U.metaTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
    />
    <slot name="head" />
  </head>
  <body class="bg-surface font-body-md text-on-surface antialiased">
    <Header lang={lang} active={active} />
    <main class="w-full pt-20 bg-surface min-h-screen">
      <div class="flex flex-col w-full">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
    <script src="https://kit.fontawesome.com/d193cb4d89.js" crossorigin="anonymous"></script>
  </body>
</html>