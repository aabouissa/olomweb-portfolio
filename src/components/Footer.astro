---
import { ui, localizedRoutes } from '@/i18n/ui.ts';

const { lang } = Astro.props as { lang: 'ar' | 'en' };
const UI = ui[lang];
const routes = localizedRoutes(lang);
import LogoRTL from '../assets/olomweb-rtl.svg'
import LogoLTR from '../assets/olomweb-ltr.svg'

const quickLinks = [
  { label: UI.footer.quick.courses, href: routes.courses },
  { label: UI.footer.quick.projects, href: routes.projects },
  { label: UI.footer.quick.about, href: routes.about },
  { label: UI.footer.quick.contact, href: routes.contact },
];
const socialLinks = [
  { aria: UI.social.youtube, icon: 'fa-brands fa-youtube fa-xl', href: 'https://youtube.com/@olomweb' },
  { aria: UI.social.github, icon: 'fa-brands fa-github fa-xl', href: 'https://github.com/aabouissa' },
  { aria: UI.social.linkedin, icon: 'fa-brands fa-linkedin fa-xl', href: 'https://linkedin.com/in/aabouissa' },
];
---

<footer class="w-full bg-surface-container-low">
  <div class="max-w-[1360px] mx-auto px-margin-mobile md:px-margin lg:px-margin-desktop py-space-xl">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-gutter-lg">
      <div class="md:col-span-2 flex flex-col gap-space-sm">
        <div class="flex items-center gap-space-sm">
          { lang === 'en'
          ? <img width="200" src={LogoLTR.src} alt="OLOMWEB">
          : <img width="200" src={LogoRTL.src} alt="OLOMWEB">
        }
        </div>
        <p class="font-body-sm text-body-sm text-on-surface-variant max-w-lg">{UI.footer.tagline}</p>
      </div>
      <div class="flex flex-col gap-space-xs">
        <span class="font-headline-sm text-headline-sm text-on-surface">{UI.footer.quickTitle}</span>
        {
          quickLinks.map((link) => (
            <a
              class="font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface transition-colors"
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </div>
      <div class="flex flex-col gap-space-xs">
        <span class="font-headline-sm text-headline-sm text-on-surface">{UI.footer.communityTitle}</span>
        <p class="font-body-sm text-body-sm text-on-surface-variant">{UI.footer.communityText}</p>
        <div class="flex items-center gap-space-sm mt-space-xs">
          {
            socialLinks.map((icon) => (
              <a
                aria-label={icon.aria}
                class="w-9 h-9 rounded-lg bg-surface flex items-center justify-center text-secondary hover:bg-surface-container-high transition-colors"
                href={icon.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class={icon.icon}></i>
              </a>
            ))
          }
        </div>
      </div>
    </div>
    <div class="mt-space-xl pt-space-md flex flex-col sm:flex-row items-center justify-between gap-space-sm font-label-sm text-label-sm text-on-surface-variant">
      <p>{UI.footer.copyright}</p>
      <p class="font-code-sm text-code-sm">{UI.footer.builtWith}</p>
    </div>
  </div>
</footer>